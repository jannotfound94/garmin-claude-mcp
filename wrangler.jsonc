{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin-claude-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // The id below is a placeholder. Deploy to Cloudflare replaces it with a
  // freshly provisioned namespace. Deploying manually? Run
  // `npx wrangler kv namespace create OAUTH_KV` and paste the real id here.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "1cef06fbfff945e19dd1a97a3a3a4664" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "MyMCP" },
      { "name": "COACH_STATE", "class_name": "CoachState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MyMCP"] },
    { "tag": "v2", "new_sqlite_classes": ["CoachState"] }
  ],
  // Coach scheduler: every 15 minutes checks for new runs, daily check-ins and
  // check-ins the coach scheduled for itself. Free on Cloudflare.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Lets src/index.ts import coach/TRENER.md as text.
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ]
}
